# Ignore everything by default
*

# Allow directory traversal
!*/

# Exclude generated/vendor directories (don't traverse)
.git/
__pycache__/
.pytest_cache/
*.egg-info/
.eggs/
counter_cpp/eigen3/
.vscode/
counter_cpp/build/
.idea/

# Python source
!*.py
!*.pyx

# Documentation
!*.md
!*.rst
!*.txt

# Config files
!*.yml
!*.yaml
!*.toml
!*.json
!*.cfg
!*.cff
!*.ini

# Data (CSV text format)
!*.csv

# C/C++
!*.c
!*.cpp
!*.h
!*.hpp

# Shell scripts
!*.sh
!*.bash

# Web
!*.html
!*.css
!*.js

# Jupyter notebooks
!*.ipynb

# Build system
!*.cmake
!CMakeLists.txt
!Makefile
!Makefile.*

# Docker
!Dockerfile
!Dockerfile.*

# System service
!*.service

# Git config
!.gitignore
!.gitattributes
!.dockerignore

# License
!LICENSE
!COPYING

# Other text formats
!*.xml
